# Copy this file to web/.env and fill in real values from the
# Firebase console: Project settings → General → Your apps → Web app.
# All VITE_ values are embedded in the public bundle, so:
#   1. Lock the API key to your domains in Google Cloud Console
#      (APIs & Services → Credentials → HTTP referrers).
#   2. Use Firestore Security Rules + Storage Rules to protect data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
